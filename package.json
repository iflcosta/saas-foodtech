{
  "name": "saas-foodtech",
  "private": true,
  "version": "0.0.0",
  "description": "SaaS Foodtech POS & Delivery — multi-tenant PDV + delivery (MVP V1.0).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/api",
    "apps/pos",
    "apps/bridge",
    "packages/db",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm-run-all2 -p dev:api dev:pos dev:bridge",
    "dev:api": "npm run dev -w apps/api",
    "dev:pos": "npm run dev -w apps/pos",
    "dev:bridge": "npm run dev -w apps/bridge",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push -w packages/db",
    "db:generate": "npm run db:generate -w packages/db",
    "diagnostics:local": "node scripts/diagnostics-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.15.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
